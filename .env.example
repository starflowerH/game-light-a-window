# Copy to .env and fill in. NEVER commit the real .env.
# The real file lives on the server at /etc/default/light-a-window (mode 600).

# Upstream OpenAI-compatible API used by the four agents.
AI_BASE=https://t.xiaoxin.email/v1
AI_MODEL=deepseek-v4.1-flash
# Required for the agent routes to reach a model. Without it every agent falls
# back to the hand-written graph in src/narrative-graph.js, and the game is
# still fully playable.
AI_KEY=

# HTTP port for the Fastify server (nginx proxies /api/ here).
PORT=3101

# Bind address. 127.0.0.1 is correct behind nginx.
HOST=127.0.0.1

# Where the SQLite database (players, runs, whispers, heat, cache) is written.
# The deploy script never deletes or overwrites this directory.
DATA_DIR=./data
