# Copy to .env and fill in. NEVER commit the real .env.
# The real file lives on the server at /etc/default/light-a-window (mode 600).

# Upstream OpenAI-compatible API for content generation.
AI_BASE=https://t.xiaoxin.email/v1
AI_MODEL=deepseek-v4.1-flash
# Required for POST /api/generate to work. Without it the endpoint returns 503
# and the game falls back to the bundled local content set.
AI_KEY=

# HTTP port for the Fastify server (nginx proxies /api/ here).
PORT=3101

# Where the SQLite database is written.
DATA_DIR=./data
